def unconfigured_record() -> dict[str, Any]:
    return {
        "ready": False,
        "authHelpText": AUTH_HELP,
        "usageStatusText": "OpenDota not configured",
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--force", action="store_true", help="walk all endpoints and rewrite the record")
    parser.add_argument("--summary-only", action="store_true", help="reuse cached matches; only refresh profile and /wl")
    parser.add_argument("--demo", action="store_true", help="emit synthetic demo data without hitting OpenDota")
    parser.add_argument("--account-id", type=str, default=None)
    args = parser.parse_args()

    account_id = resolve_account_id(args.account_id)
    if not account_id:
        print(json.dumps(unconfigured_record(), separators=(",", ":")))
        return 0

    if args.demo:
        print(json.dumps(demo_record(account_id), separators=(",", ":")))
        return 0

    heroes = load_heroes()
    cached = load_cached(record_path())
    cached = cached if isinstance(cached, dict) else {}

    endpoints: dict[str, Any] = {}
    if args.force or not cached:
        endpoints = fetch_endpoints(account_id)
    elif args.summary_only:
        with ThreadPoolExecutor(max_workers=2) as pool:
            profile_future = pool.submit(http_get_json, f"{API_BASE}/players/{account_id}")
            wl_future = pool.submit(http_get_json, f"{API_BASE}/players/{account_id}/wl")
            endpoints["profile"] = profile_future.result()
            endpoints["wl"] = wl_future.result()
        endpoints["matches"] = cached.get("__matches")
        endpoints["heroes"] = cached.get("__heroes")
    else:
        endpoints = fetch_endpoints(account_id)

    matches_for_cache = endpoints.get("matches") if isinstance(endpoints.get("matches"), list) else []
    heroes_for_cache = endpoints.get("heroes") if isinstance(endpoints.get("heroes"), list) else None

    record = build_record(account_id, endpoints, heroes)
    cache_payload = dict(record)
    if isinstance(matches_for_cache, list):
        cache_payload["__matches"] = matches_for_cache
    if isinstance(heroes_for_cache, list):
        cache_payload["__heroes"] = heroes_for_cache
    write_json(record_path(), cache_payload)

    safe_record = {key: value for key, value in record.items() if not key.startswith("__")}
    print(json.dumps(safe_record, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
