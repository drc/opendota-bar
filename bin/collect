#!/usr/bin/python3
# omarchy:summary=Print the OpenDota player record as JSON
# omarchy:args=[--force] [--summary-only]
# omarchy:hidden=true
"""Collect one display-ready record for an OpenDota player.

The agents panel shows Dota 2 stats from OpenDota's public REST API.
Everything the panel needs comes from a single record emitted by this
script: profile + rank from /players/{id}, all-time win/loss from
/players/{id}/wl queried with significant=0 so unparsed matches count
(mode splits via game_mode and lobby_type filters), per-hero stats from
/players/{id}/heroes, and the 100-match history from /players/{id}/matches.
The 100-match history is bucketed by game_mode and lobby_type so turbo,
ranked, and unranked each get their own rollup; recent matches and top
heroes use that sample while the headline and MODES rows use the
all-time totals.

A heavy refresh walks all endpoints in parallel and writes the result
to record.json. A summary refresh reuses the cached 100-match walk and
only re-fetches the cheap profile and /wl endpoints. Hero names come
from a one-shot /api/heroes lookup cached in heroes.json.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path
from typing import Any

AGENT_ID = "opendota"
AUTH_HELP = (
  "Could not find your OpenDota account id. "
  "Set OPENDOTA_ACCOUNT_ID, add accountId to ~/.config/omarchy/agents/opendota.json, "
  "or sign into Steam on this machine."
)
API_BASE = "https://api.opendota.com/api"
USER_AGENT = "omarchy-drc.opendota/1.0"
HTTP_TIMEOUT = 25
AUTO_REFRESH_TTL_SEC = 6 * 60 * 60
MAX_RESPONSE_BYTES = 2 * 1024 * 1024
MAX_CACHE_BYTES = 4 * 1024 * 1024

TURBO_GAME_MODES = {23, 20, 21, 22}
RANKED_LOBBY_TYPE = 8

TIER_NAMES = {
    1: "Herald",
    2: "Guardian",
    3: "Crusader",
    4: "Archon",
    5: "Legend",
    6: "Ancient",
    7: "Divine",
    8: "Immortal",
}

TIER_MMR_MIDPOINTS = {
    1: 300,
    2: 850,
    3: 1350,
    4: 1850,
    5: 2350,
    6: 2850,
    7: 3350,
    8: 3800,
}


def cache_root() -> Path:
    root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy" / "opendota"
    root.mkdir(parents=True, exist_ok=True)
    os.chmod(root, 0o700)
    if root.is_symlink() or not root.is_dir() or root.stat().st_uid != os.getuid() or root.stat().st_mode & 0o077:
        raise OSError(f"unsafe cache directory: {root}")
    return root


def config_path() -> Path:
    config_home = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
    return config_home / "omarchy" / "agents" / "opendota.json"


def record_path() -> Path:
    return cache_root() / "record.json"


def heroes_path() -> Path:
    return cache_root() / "heroes.json"


def load_cached(path: Path) -> Any:
    try:
        if path.stat().st_size > MAX_CACHE_BYTES:
            return None
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def write_json(path: Path, payload: Any) -> None:
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    tmp = Path(tmp_name)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, separators=(",", ":"))
        tmp.replace(path)
    finally:
        tmp.unlink(missing_ok=True)


class OpenDotaRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        parsed = urllib.parse.urlsplit(newurl)
        if parsed.scheme != "https" or parsed.hostname != "api.opendota.com":
            raise urllib.error.URLError("redirect outside api.opendota.com")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def http_get_json(url: str) -> Any:
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "application/json"})
    try:
        opener = urllib.request.build_opener(OpenDotaRedirectHandler)
        with opener.open(request, timeout=HTTP_TIMEOUT) as response:
            content_length = response.headers.get("Content-Length")
            if content_length and int(content_length) > MAX_RESPONSE_BYTES:
                raise ValueError("response exceeds size limit")
            chunks: list[bytes] = []
            size = 0
            while True:
                chunk = response.read(min(65536, MAX_RESPONSE_BYTES - size + 1))
                if not chunk:
                    break
                chunks.append(chunk)
                size += len(chunk)
                if size > MAX_RESPONSE_BYTES:
                    raise ValueError("response exceeds size limit")
            payload = b"".join(chunks).decode("utf-8", errors="replace")
    except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError, OSError, ValueError) as error:
        print(f"opendota: {url} -> {type(error).__name__}: {error}", file=sys.stderr)
        return None
    try:
        return json.loads(payload)
    except json.JSONDecodeError as error:
        print(f"opendota: {url} -> JSON decode error: {error}", file=sys.stderr)
        return None


def valid_account_id(value: Any) -> str | None:
    candidate = str(value).strip() if value is not None else ""
    if candidate and candidate.isascii() and candidate.isdigit() and len(candidate) <= 10:
        return candidate
    return None


def resolve_account_id(arg_value: str | None) -> str:
    if arg_value and arg_value.strip():
        return valid_account_id(arg_value) or ""
    env = os.environ.get("OPENDOTA_ACCOUNT_ID", "").strip()
    if env:
        return valid_account_id(env) or ""
    try:
        cfg = json.loads(config_path().read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        cfg = {}
    if isinstance(cfg, dict):
        candidate = cfg.get("accountId")
        if candidate is not None:
            candidate = str(candidate).strip()
            if candidate:
                return valid_account_id(candidate) or ""
    steam_id = resolve_steam_account_id()
    if steam_id:
        return steam_id
    return ""


STEAMID64_BASE = 76561197960265728


def _steam_userdata_dirs() -> list[Path]:
    paths: list[Path] = []
    for root in (Path.home() / ".steam" / "steam" / "userdata",
                 Path.home() / ".local" / "share" / "Steam" / "userdata"):
        if root.is_dir():
            paths.append(root)
    return paths


def _parse_loginusers_vdf(path: Path) -> list[tuple[int, int]]:
    if not path.is_file():
        return []
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []
    entries: list[tuple[int, int]] = []
    current_steam64: int | None = None
    current_timestamp: int = 0
    current_autologin: bool = False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith('"') and stripped.endswith('"') and '"AccountName"' not in stripped \
                and '"PersonaName"' not in stripped and '"RememberPassword"' not in stripped \
                and '"WantsOfflineMode"' not in stripped and '"SkipOfflineModeWarning"' not in stripped \
                and '"AutoLogin"' not in stripped and '"Timestamp"' not in stripped:
            token = stripped.strip('"')
            if token.isdigit() and len(token) >= 16:
                current_steam64 = int(token)
                current_timestamp = 0
                current_autologin = False
        elif '"AutoLogin"' in stripped:
            parts = stripped.split('"')
            if len(parts) >= 4 and parts[-2] == "1":
                current_autologin = True
        elif '"Timestamp"' in stripped:
            parts = stripped.split('"')
            for p in parts:
                if p.isdigit() and len(p) >= 8:
                    current_timestamp = int(p)
                    break
        if current_steam64 is not None and current_steam64 >= STEAMID64_BASE:
            if current_autologin or current_timestamp > 0:
                entries.append((current_timestamp, current_steam64))
    return entries


def resolve_steam_account_id() -> str:
    for root in _steam_userdata_dirs():
        try:
            candidates = [p for p in root.iterdir() if p.is_dir() and p.name.isdigit()]
        except OSError:
            continue
        if not candidates:
            continue
        candidates.sort(key=lambda p: p.stat().st_mtime, reverse=True)
        for c in candidates:
            name = c.name
            if len(name) >= 16:
                steam_id = int(name) - STEAMID64_BASE
            else:
                steam_id = int(name)
            if steam_id > 0:
                return str(steam_id)
    vdf_candidates: list[Path] = []
    for parent in (Path.home() / ".steam" / "steam" / "config",
                   Path.home() / ".local" / "share" / "Steam" / "config"):
        vdf_candidates.append(parent / "loginusers.vdf")
    entries: list[tuple[int, int]] = []
    for path in vdf_candidates:
        entries.extend(_parse_loginusers_vdf(path))
    if not entries:
        return ""
    entries.sort(key=lambda item: item[0], reverse=True)
    newest_timestamp, newest_steam64 = entries[0]
    return str(newest_steam64 - STEAMID64_BASE)


def load_heroes() -> dict[str, str]:
    cached = load_cached(heroes_path())
    if isinstance(cached, dict) and cached:
        return cached
    data = http_get_json(f"{API_BASE}/heroes")
    names: dict[str, str] = {}
    if isinstance(data, list):
        for entry in data:
            if not isinstance(entry, dict):
                continue
            hero_id = entry.get("id")
            name = entry.get("localized_name") or entry.get("name") or ""
            if hero_id is not None and name:
                names[str(hero_id)] = str(name)
    if names:
        write_json(heroes_path(), names)
    return names


def hero_name(heroes: dict[str, str], hero_id: Any) -> str:
    if hero_id is None:
        return ""
    return heroes.get(str(hero_id), "")


def _newest_start(matches_list: list[dict[str, Any]]) -> int:
    latest = 0
    for m in matches_list:
        t = match_int(m, "start_time")
        if t > latest:
            latest = t
    return latest


def lifetime_wl_urls(account_id: str) -> dict[str, str]:
    base = f"{API_BASE}/players/{account_id}/wl"
    return {
        "wlAll": f"{base}?significant=0",
        "wlTurbo": f"{base}?game_mode=23&significant=0",
        "wlRanked": f"{base}?lobby_type={RANKED_LOBBY_TYPE}&significant=0",
    }


def fetch_endpoints(account_id: str) -> dict[str, Any]:
    urls = {
        "profile": f"{API_BASE}/players/{account_id}",
        "wl": f"{API_BASE}/players/{account_id}/wl",
        **lifetime_wl_urls(account_id),
        "heroes": f"{API_BASE}/players/{account_id}/heroes",
        "matches": f"{API_BASE}/players/{account_id}/matches?limit=100",
        "recentMatches": f"{API_BASE}/players/{account_id}/recentMatches",
    }
    results: dict[str, Any] = {}
    with ThreadPoolExecutor(max_workers=len(urls)) as pool:
        futures = {key: pool.submit(http_get_json, url) for key, url in urls.items()}
        for key, future in futures.items():
            results[key] = future.result()

    matches = results.get("matches")
    recent = results.get("recentMatches")
    if not isinstance(matches, list) or len(matches) == 0:
        if isinstance(recent, list) and len(recent) > 0:
            results["matches"] = recent
    elif isinstance(matches, list) and isinstance(recent, list) and recent:
        if _newest_start(recent) > _newest_start(matches):
            results["matches"] = recent
    return results


def empty_bucket() -> dict[str, Any]:
    return {"games": 0, "win": 0, "lose": 0, "winRate": 0.0, "kda": 0.0, "lastPlayedAt": 0}


def is_radiant_win(player_slot: Any, radiant_win: Any) -> bool | None:
    if radiant_win is None:
        return None
    slot = int(player_slot or 0)
    if slot < 128:
        on_radiant = True
    else:
        on_radiant = False
    return bool(radiant_win) == on_radiant


def match_int(match: dict[str, Any], key: str) -> int:
    return safe_int(match.get(key))


def safe_int(value: Any) -> int:
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def match_mode(match: dict[str, Any]) -> str:
    if match_int(match, "game_mode") in TURBO_GAME_MODES:
        return "turbo"
    if match_int(match, "lobby_type") == RANKED_LOBBY_TYPE:
        return "ranked"
    return "unranked"


def match_won(match: dict[str, Any]) -> bool | None:
    try:
        return is_radiant_win(match.get("player_slot"), match.get("radiant_win"))
    except (TypeError, ValueError):
        return None


def bucket_matches(matches: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    buckets = {
        "all": {"kills": 0, "assists": 0, "deaths": 0, "no_death_games": 0, "turbo": False},
        "turbo": {"kills": 0, "assists": 0, "deaths": 0, "no_death_games": 0, "turbo": True},
        "ranked": {"kills": 0, "assists": 0, "deaths": 0, "no_death_games": 0, "turbo": False},
        "unranked": {"kills": 0, "assists": 0, "deaths": 0, "no_death_games": 0, "turbo": False},
    }
    for name in buckets:
        buckets[name].update({"games": 0, "win": 0, "lose": 0, "lastPlayedAt": 0})

    for match in matches:
        if not isinstance(match, dict):
            continue
        won = match_won(match)
        if won is None:
            continue
        kills = match_int(match, "kills")
        assists = match_int(match, "assists")
        deaths = match_int(match, "deaths")
        started_at = match_int(match, "start_time")
        mode = match_mode(match)

        targets: list[str] = ["all"]
        targets.append(mode)

        for name in targets:
            bucket = buckets[name]
            bucket["games"] += 1
            if won:
                bucket["win"] += 1
            else:
                bucket["lose"] += 1
            if started_at > bucket["lastPlayedAt"]:
                bucket["lastPlayedAt"] = started_at
            bucket["kills"] += kills
            bucket["assists"] += assists
            bucket["deaths"] += deaths
            if deaths == 0:
                bucket["no_death_games"] += 1

    rollups: dict[str, dict[str, Any]] = {}
    for name, bucket in buckets.items():
        games = bucket["games"]
        win = bucket["win"]
        lose = bucket["lose"]
        win_rate = round((win / games) * 100, 1) if games else 0.0
        if bucket["deaths"] == 0:
            kda = round(bucket["kills"] + bucket["assists"], 1) if (bucket["kills"] + bucket["assists"]) else 0.0
        else:
            kda = round((bucket["kills"] + bucket["assists"]) / bucket["deaths"], 1)
        rollups[name] = {
            "games": games,
            "win": win,
            "lose": lose,
            "winRate": win_rate,
            "kda": kda,
            "lastPlayedAt": bucket["lastPlayedAt"],
        }
    return rollups


def compute_streak(matches: list[dict[str, Any]], sample: list[dict[str, Any]]) -> dict[str, Any]:
    if len(sample) < 2:
        return {"current": 0, "kind": "none"}
    first_won = match_won(sample[0])
    if first_won is None:
        return {"current": 0, "kind": "none"}
    kind = "win" if first_won else "lose"
    length = 0
    for match in sample:
        won = match_won(match)
        if won is None:
            break
        if (kind == "win" and won) or (kind == "lose" and not won):
            length += 1
        else:
            break
    if length < 2:
        return {"current": 0, "kind": "none"}
    return {"current": length, "kind": kind}


def matches_for_mode(matches: list[dict[str, Any]], mode_id: str) -> list[dict[str, Any]]:
    out: list[dict[str, Any]] = []
    for match in matches:
        if not isinstance(match, dict):
            continue
        if match_mode(match) == mode_id:
            out.append(match)
    return out


def recent_for_mode(matches: list[dict[str, Any]], heroes: dict[str, str], mode_id: str, limit: int = 10) -> list[dict[str, Any]]:
    recent: list[dict[str, Any]] = []
    for match in matches_for_mode(matches, mode_id):
        won = match_won(match)
        if won is None:
            continue
        hero_id = match.get("hero_id")
        recent.append({
            "matchId": str(match.get("match_id") or ""),
            "heroId": match_int({"hero_id": hero_id}, "hero_id"),
            "heroName": hero_name(heroes, hero_id),
            "won": bool(won),
            "kills": match_int(match, "kills"),
            "deaths": match_int(match, "deaths"),
            "assists": match_int(match, "assists"),
            "duration": match_int(match, "duration"),
            "startedAt": match_int(match, "start_time"),
        })
        if len(recent) >= limit:
            break
    return recent


def top_heroes_for_mode(matches: list[dict[str, Any]], heroes: dict[str, str], mode_id: str, limit: int = 5) -> list[dict[str, Any]]:
    counts: dict[str, dict[str, int]] = {}
    for match in matches_for_mode(matches, mode_id):
        hero_id = match.get("hero_id")
        if hero_id is None:
            continue
        bucket = counts.setdefault(str(hero_id), {"games": 0, "win": 0})
        bucket["games"] += 1
        if match_won(match):
            bucket["win"] += 1
    ranked = sorted(counts.items(), key=lambda item: (-item[1]["games"], item[0]))[:limit]
    return [
        {"heroId": match_int({"hero_id": hero_id}, "hero_id"), "name": hero_name(heroes, hero_id),
         "games": bucket["games"], "win": bucket["win"]}
        for hero_id, bucket in ranked
    ]


def last_match_at(matches: list[dict[str, Any]]) -> int:
    latest = 0
    for match in matches:
        if isinstance(match, dict):
            started = match_int(match, "start_time")
            if started > latest:
                latest = started
    return latest


def data_status(matches: list[Any], wl: Any) -> str:
    matches_empty = not matches
    if isinstance(matches, dict):
        matches_empty = False
    if isinstance(matches, list) and len(matches) > 0:
        matches_empty = False
    wl_empty = False
    if isinstance(wl, dict):
        wl_empty = safe_int(wl.get("win")) == 0 and safe_int(wl.get("lose")) == 0
    elif wl is None:
        wl_empty = True
    if matches_empty and wl_empty:
        return "private"
    return "public"


def synth_wl_from_matches(matches: list[dict[str, Any]]) -> dict[str, Any]:
    win = 0
    lose = 0
    for match in matches:
        won = match_won(match)
        if won is True:
            win += 1
        elif won is False:
            lose += 1
    return {"win": win, "lose": lose}


def lifetime_bucket(win: int, lose: int) -> dict[str, Any]:
    games = win + lose
    rate = round(100.0 * win / games, 1) if games else 0.0
    return {"games": games, "win": win, "lose": lose, "winRate": rate}


def lifetime_from_endpoints(endpoints: dict[str, Any]) -> dict[str, dict[str, Any]] | None:
    def as_wl(key: str) -> dict[str, Any]:
        value = endpoints.get(key)
        return value if isinstance(value, dict) else {}

    all_wl = as_wl("wlAll")
    all_w = safe_int(all_wl.get("win"))
    all_l = safe_int(all_wl.get("lose"))
    if all_w + all_l == 0:
        return None

    turbo = as_wl("wlTurbo")
    ranked = as_wl("wlRanked")
    turbo_w = safe_int(turbo.get("win"))
    turbo_l = safe_int(turbo.get("lose"))
    ranked_w = safe_int(ranked.get("win"))
    ranked_l = safe_int(ranked.get("lose"))
    unranked_w = max(0, all_w - turbo_w - ranked_w)
    unranked_l = max(0, all_l - turbo_l - ranked_l)
    return {
        "all": lifetime_bucket(all_w, all_l),
        "turbo": lifetime_bucket(turbo_w, turbo_l),
        "ranked": lifetime_bucket(ranked_w, ranked_l),
        "unranked": lifetime_bucket(unranked_w, unranked_l),
    }


def build_record(account_id: str, endpoints: dict[str, Any], heroes: dict[str, str]) -> dict[str, Any]:
    outer = endpoints.get("profile") if isinstance(endpoints.get("profile"), dict) else {}
    profile = outer.get("profile") if isinstance(outer.get("profile"), dict) else {}
    wl = endpoints.get("wl") if isinstance(endpoints.get("wl"), dict) else {}
    matches_raw = endpoints.get("matches")
    matches = [m for m in matches_raw if isinstance(m, dict)] if isinstance(matches_raw, list) else []

    rollups = bucket_matches(matches)
    streak_mode = "turbo" if rollups["turbo"]["games"] >= 5 else "all"
    streak_sample = matches_for_mode(matches, streak_mode) if streak_mode != "all" else matches

    wl_synth = synth_wl_from_matches(matches)
    if (safe_int(wl.get("win")) + safe_int(wl.get("lose"))) == 0 and (wl_synth["win"] + wl_synth["lose"]) > 0:
        wl = wl_synth

    lifetime = lifetime_from_endpoints(endpoints)
    if lifetime is None:
        lifetime = rollups

    rank_tier = outer.get("rank_tier")
    try:
        tier_int = int(rank_tier) if rank_tier is not None else 0
    except (TypeError, ValueError):
        tier_int = 0
    tier_name = TIER_NAMES.get(tier_int, "Unranked")
    leaderboard = outer.get("leaderboard_rank") if tier_int == 8 else None
    mmr_estimate = TIER_MMR_MIDPOINTS.get(tier_int, 0)

    record = {
        "ready": True,
        "accountId": account_id,
        "profile": {
            "personaname": str(profile.get("personaname") or ""),
            "avatarfull": str(profile.get("avatarfull") or profile.get("avatar") or ""),
            "isPlus": bool(profile.get("plus") or profile.get("is_plus")),
        },
        "rank": {
            "tier": tier_int,
            "name": tier_name,
            "leaderboardRank": leaderboard,
            "mmrEstimate": mmr_estimate,
        },
        "dataStatus": data_status(matches_raw, wl),
        "modes": rollups,
        "lifetime": lifetime,
        "recentByMode": {
            "turbo": recent_for_mode(matches, heroes, "turbo"),
            "ranked": recent_for_mode(matches, heroes, "ranked"),
            "unranked": recent_for_mode(matches, heroes, "unranked"),
        },
        "topHeroesByMode": {
            "turbo": top_heroes_for_mode(matches, heroes, "turbo"),
            "ranked": top_heroes_for_mode(matches, heroes, "ranked"),
            "unranked": top_heroes_for_mode(matches, heroes, "unranked"),
        },
        "streak": compute_streak(matches, streak_sample),
        "lastMatchAt": last_match_at(matches),
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "updatedAtMs": int(dt.datetime.now(dt.timezone.utc).timestamp() * 1000),
    }
    return record


def demo_record(account_id: str) -> dict[str, Any]:
    now_ms = int(dt.datetime.now(dt.timezone.utc).timestamp() * 1000)
    one_day = 24 * 60 * 60
    turbo_matches = [
        {"heroId": 14,  "heroName": "Pudge",     "won": True,  "kills": 12, "deaths": 3,  "assists": 18, "duration": 1845, "startedAt": (now_ms - 1 * 3600 * 1000) // 1000},
