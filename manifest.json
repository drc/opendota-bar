{
  "schemaVersion": 1,
  "id": "io.github.drc.opendota",
  "name": "OpenDota",
  "version": "1.0.0",
  "author": "drc",
  "license": "MIT",
  "description": "Dota 2 stats from OpenDota: rank, recent turbo matches, top heroes, in the Omarchy bar.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OpenDota",
    "description": "Rank, turbo mode win rate, recent turbo matches, and top turbo heroes. Right-click to refresh.",
    "category": "Game",
    "aliases": ["opendota", "dota"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "accountId": "",
      "refreshIntervalSec": 600,
      "summaryRefreshSec": 60,
      "recentMatchesCount": 10,
      "topHeroesCount": 5,
      "urgentStreakMin": 3,
      "urgentWinRatePct": 45,
      "maxPanelHeight": 900,
      "demo": false
    },
    "schema": [
      {"key": "accountId", "type": "string", "label": "OpenDota account id (overrides Steam auto-detect)", "placeholder": "83730627"},
      {"key": "refreshIntervalSec", "type": "integer", "label": "Full refresh (seconds)", "min": 60, "max": 3600, "step": 60, "defaultValue": 600},
      {"key": "summaryRefreshSec", "type": "integer", "label": "Light refresh (seconds)", "min": 30, "max": 600, "step": 30, "defaultValue": 60},
      {"key": "recentMatchesCount", "type": "integer", "label": "Recent matches shown", "min": 5, "max": 20, "step": 1, "defaultValue": 10},
      {"key": "topHeroesCount", "type": "integer", "label": "Top heroes shown", "min": 3, "max": 10, "step": 1, "defaultValue": 5},
      {"key": "urgentStreakMin", "type": "integer", "label": "Lose streak to flag urgent", "min": 2, "max": 10, "step": 1, "defaultValue": 3},
      {"key": "urgentWinRatePct", "type": "integer", "label": "Win rate % to flag urgent (primary mode)", "min": 20, "max": 80, "step": 1, "defaultValue": 45},
      {"key": "maxPanelHeight", "type": "integer", "label": "Max panel height (px, clamped to screen)", "min": 400, "max": 2400, "step": 20, "defaultValue": 900},
      {"key": "demo", "type": "bool", "label": "Show synthetic demo data (preview only)", "defaultValue": false}
    ]
  }
}
